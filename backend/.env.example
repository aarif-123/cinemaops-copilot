# ─── MongoDB Atlas ───────────────────────────────────────────────────────────
# Use a MongoDB database-user connection string, not an Atlas project API key.
# URL-encode special characters in the username/password.
MONGODB_URI=mongodb+srv://<db-user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=cinemaops

# ─── Redis (Upstash or local) ────────────────────────────────────────────────
# Upstash: rediss://default:<password>@<host>.upstash.io:6379
# Local:   redis://localhost:6379
REDIS_URL=redis://localhost:6379

# ─── Groq LLM ────────────────────────────────────────────────────────────────
GROQ_API_KEY=gsk_your_groq_api_key_here

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Secret used to sign internal admin JWTs. Use: openssl rand -hex 32
JWT_SECRET=replace-with-32-byte-random-hex-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480
# Login credential for the local admin dashboard. Generate the hash with:
# python -c "from app.middleware.auth import hash_password; print(hash_password('change-me'))"
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=pbkdf2_sha256$310000$replace-with-salt$replace-with-digest

# ─── App ──────────────────────────────────────────────────────────────────────
APP_ENV=development           # development | production
LOG_LEVEL=INFO
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ─── Agent tuning ─────────────────────────────────────────────────────────────
GROQ_MODEL=llama-3.3-70b-versatile
AGENT_MAX_ITERATIONS=10
REDIS_LOCK_TTL_SECONDS=120

# ─── Fiscal guardrails ────────────────────────────────────────────────────────
MAX_FLASH_DISCOUNT_PCT=35
MAX_VOUCHER_VALUE_PAISA=25000    # ₹250 in paisa
DAILY_VOUCHER_BUDGET_PAISA=250000  # ₹2500 in paisa

# ─── LangSmith (optional — add key to enable tracing) ────────────────────────
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=ls__your_langsmith_key
# LANGCHAIN_PROJECT=cinemaops-copilot
